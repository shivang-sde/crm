# Playwright E2E Test Environment Configuration
# Copy to .env.test.local for local overrides (gitignored)

# Base URLs
PLAYWRIGHT_BASE_URL=http://localhost:3000
PLAYWRIGHT_API_BASE_URL=http://localhost:8080/api/v1

# Test credentials (use dedicated test tenant/user - NEVER production)
TEST_TENANT_NAME=E2E Test Tenant
TEST_TENANT_SLUG=e2e-test-tenant
TEST_ADMIN_EMAIL=admin@e2e-test.local
TEST_ADMIN_PASSWORD=TestPass123!
TEST_USER_EMAIL=user@e2e-test.local
TEST_USER_PASSWORD=TestPass123!

# Database (uses backend's test profile H2 by default)
# Override for dedicated test DB if needed
# TEST_DATABASE_URL=jdbc:postgresql://localhost:5433/crm_test

# Timeout settings
PLAYWRIGHT_TIMEOUT=60000
PLAYWRIGHT_ACTION_TIMEOUT=15000
PLAYWRIGHT_NAVIGATION_TIMEOUT=30000

# Async polling
POLL_INTERVAL_MS=2000
POLL_TIMEOUT_MS=30000

# CI flags
CI=false